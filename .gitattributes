# Los scripts que corren en CloudShell/Linux DEBEN quedar con saltos LF.
# Si git los convierte a CRLF, bash falla con: $'\r': command not found
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf

# Estos si van con saltos de Windows
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binarios: que git no los toque
*.parquet binary
*.zip     binary
*.png     binary
